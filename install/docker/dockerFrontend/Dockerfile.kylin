# ============================================================================
# Cube Studio — 麒麟信创 前端生产镜像
# ★ 零联网操作 — 仅 COPY 前端构建产物
# ★ 前置: dockerFrontend/Dockerfile-base.kylin 已构建为 kylin-base
#
# 构建:
#   docker build --network=none \
#     -t 192.168.11.12/cube-studio/kubeflow-dashboard-frontend:kylin-20260730 \
#     -f install/docker/dockerFrontend/Dockerfile.kylin .
# ============================================================================

FROM 192.168.11.12/cube-studio/kubeflow-dashboard-frontend:kylin-base

# ── 前端构建产物 ──────────────────────────────────────────
COPY myapp/static/appbuilder/frontend /data/web/frontend
RUN rm -rf /data/web/frontend/manifest.json /data/web/frontend/robots.txt
